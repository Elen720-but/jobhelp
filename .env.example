# Copie ce fichier en ".env" et remplis tes vraies informations.
# Ne partage JAMAIS ton fichier .env (il est déjà exclu via .gitignore).

# Adresse Gmail utilisée pour ENVOYER les emails (ex: jobboost.contact@gmail.com)
EMAIL_USER=ton.adresse@gmail.com

# Mot de passe d'application Gmail (PAS ton mot de passe habituel, voir README)
EMAIL_PASS=xxxx xxxx xxxx xxxx

# Adresse qui reçoit les notifications admin (peut être la même que EMAIL_USER)
ADMIN_EMAIL=ton.adresse@gmail.com

# Port du serveur (optionnel)
PORT=3000
